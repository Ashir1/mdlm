# Copy this file to ``.env`` and fill in the values for your environment.
# ``train_scripts/*.sbatch`` and the launch helpers source ``.env`` if present.

# --- Weights & Biases ---------------------------------------------------
# Override these to log into your own entity / project. Set
# ``WANDB_MODE=offline`` (or ``WANDB_DISABLED=true``) to skip logging
# entirely. The authors' entity is withheld during the double-blind
# review period.
WANDB_ENTITY=
WANDB_PROJECT=Fast-dLLM-v2

# --- Filesystem layout --------------------------------------------------
# Relative paths are resolved against ``Fast-dLLM/v2/``.
DATA_DIR=data
HF_HOME=hf_home
HF_DATASETS_CACHE=hf_datasets_cache
LOG_DIR=logs

# --- Misc ---------------------------------------------------------------
TOKENIZERS_PARALLELISM=false
PROJECT_ROOT=.
HYDRA_FULL_ERROR=1
OC_CAUSE=1
TORCHDYNAMO_CAPTURE_SCALAR_OUTPUTS=1

# --- Slurm / cluster ----------------------------------------------------
# Set EMAIL to receive Slurm BEGIN/END/FAIL/REQUEUE notifications, or leave
# blank to silence them. CONDA_ROOT, CONDA_ENV, and RESERVATION are read by
# the sbatch wrappers; defaults are ``${HOME}/miniconda3`` and ``relay``.
EMAIL=
CONDA_ROOT=
CONDA_ENV=relay
RESERVATION=
